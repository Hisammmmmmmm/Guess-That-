# ==============================================================================
# Configuration Nginx recommandée pour Guess That
# Domaine exemple : guess-that.drocsid.site
# Fichier cible : /etc/nginx/sites-available/guess-that
# ==============================================================================

# 1. Redirection automatique HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name guess-that.drocsid.site;

    return 301 https://$host$request_uri;
}

# 2. Serveur HTTPS & Reverse Proxy vers Node.js
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name guess-that.drocsid.site;

    # Chemins vers vos certificats SSL (ex. générés par Certbot / Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/guess-that.drocsid.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/guess-that.drocsid.site/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Taille maximale des requêtes acceptées (pour les avatars, données de quiz, etc.)
    client_max_body_size 25M;

    # Compression Gzip pour des transferts rapides
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;

    # REVERSE PROXY VERS LE SERVEUR NODE.JS (port 3000 par défaut)
    # Node.js sert à la fois :
    # - Le frontend React (HTML/JS/CSS statiques)
    # - Les routes API (/api/generate-quiz, /api/tts, etc.)
    # - Le serveur WebSockets en temps réel (wss://)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # ESSENTIEL pour WebSockets (multijoueur temps réel)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Transmission des en-têtes d'origine
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts pour laisser à l'IA Gemini et aux recherches le temps de répondre
        proxy_connect_timeout 90s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }
}
